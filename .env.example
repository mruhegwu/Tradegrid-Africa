# ─────────────────────────────────────────────────────────
#  Tradegrid Africa – Environment Variable Template
#  Copy this file to .env and fill in real values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────

# Application
NODE_ENV=development
PORT=3000
API_PORT=4000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/tradegrid
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# AWS / Cloud
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=tradegrid-assets

# Docker Registry
DOCKER_REGISTRY=ghcr.io
DOCKER_IMAGE_WEB=tradegrid-africa/web
DOCKER_IMAGE_API=tradegrid-africa/api

# Monitoring
SENTRY_DSN=
LOG_LEVEL=info
